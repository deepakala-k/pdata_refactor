<?xml version="1.0"?>
<attributes>
  <attribute>
    <id>DISABLE_SECURITY</id>
    <description>This attribute indicates the security status . Based on this
            HWSV will update the BOOT_FLAGS attribute to disable the security. HWSV
            will detect the IPL type and set the required bits in the BOOT_FLAGS
        </description>
    <simpleType>
      <uint8_t>
        <default>0</default>
      </uint8_t>
    </simpleType>
    <persistency>non-volatile</persistency>
    <readable/>
    <writeable/>
  </attribute>

  <attribute>
    <id>EQ_GARD</id>
    <description>Capturing EQ Gard value</description>
    <no_export/>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <uint8_t/>
    </simpleType>
    <writeable/>
  </attribute>

  <attribute>
    <id>FSI_DEVICE_PATH</id>
    <description>FSI device path for cfam operations</description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <string>
        <sizeInclNull>64</sizeInclNull>
      </string>
    </simpleType>
  </attribute>

  <attribute>
    <id>FSI_PORT</id>
    <description>FSI port value</description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <uint32_t>
        <default>0</default>
      </uint32_t>
    </simpleType>
  </attribute>

  <attribute>
    <id>DIRECT_ACCESS_DEVICE_PATH</id>
    <description>Direct access path for scom operations</description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <string>
        <sizeInclNull>64</sizeInclNull>
      </string>
    </simpleType>
  </attribute>

  <attribute>
    <id>SBEFIFO_DEVICE_PATH</id>
    <description>Sbefifo device path for scom operations</description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <string>
        <sizeInclNull>64</sizeInclNull>
      </string>
    </simpleType>
  </attribute>

  <enumerationType>
    <description>
            The functional state of the system oscillators.
        </description>
    <enumerator>
      <name>NO_DECONFIG</name>
      <value>0x0</value>
    </enumerator>
    <enumerator>
      <name>A_DECONFIG</name>
      <value>0x1</value>
    </enumerator>
    <enumerator>
      <name>B_DECONFIG</name>
      <value>0x2</value>
    </enumerator>
    <enumerator>
      <name>ALL_DECONFIG</name>
      <value>0x3</value>
    </enumerator>
    <id>SYS_CLOCK_DECONFIG_STATE</id>
  </enumerationType>
  <attribute>
    <id>SYS_CLOCK_DECONFIG_STATE</id>
    <description>
            The state of the system clocks. This attribute is set by
            Hostboot and read by the BMC on reconfig loops so that it can
            tell which clocks are functional. See the enumeration
            SYS_CLOCK_DECONFIG_STATE for the possible values of this
            attribute.
        </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <writeable/>
    <simpleType>
      <enumeration>
        <default>NO_DECONFIG</default>
        <id>SYS_CLOCK_DECONFIG_STATE</id>
      </enumeration>
    </simpleType>
  </attribute>

  <attribute>
    <id>I2C_ADDRESS</id>
    <description>The I2C Address of the target to use in the device tree
            reg property. It can be added to target that wants under
            the respective I2C device tree target.
        </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <uint8_t>
        <default>0</default>
      </uint8_t>
    </simpleType>
  </attribute>

  <attribute>
    <id>I2C_PORT</id>
    <description>The I2C Port of the target to use in the device tree along
            with I2C device tree target node name. For example, i2c-N.
            It can be added to target that wants under the respective I2C
            device tree target.
        </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <uint8_t>
        <default>0</default>
      </uint8_t>
    </simpleType>
  </attribute>

  <attribute>
    <id>I2C_PARENT_PHYS_PATH</id>
    <description>The I2C target parent physical path. Used for adding the
            I2C target under the respective parent. It can be added to target
            that wants under the respective I2C device tree target.
        </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <simpleType>
      <string>
        <sizeInclNull>64</sizeInclNull>
      </string>
    </simpleType>
  </attribute>

  <enumerationType>
    <id>HW_ACCESS_METHOD</id>
    <default>SBEFIFO</default>
    <description>
            Enumeration indicating the current backend sbefifo/direct access
        </description>
    <enumerator>
      <name>SBEFIFO</name>
      <value>0</value>
    </enumerator>
    <enumerator>
      <name>DIRECT_ACCESS</name>
      <value>1</value>
    </enumerator>
  </enumerationType>
  <attribute>
    <id>HW_ACCESS_METHOD</id>
    <description>Type of the current hardware access method</description>
    <hasStringConversion/>
    <no_export/>
    <persistency>volatile</persistency>
    <readable/>
    <simpleType>
      <enumeration>
        <default>SBEFIFO</default>
        <id>HW_ACCESS_METHOD</id>
      </enumeration>
    </simpleType>
    <writeable/>
  </attribute>
  
  <attribute>
    <id>HW_ACCESS_PTR</id>
    <description>Hardware access pointer</description>
    <no_export/>
    <persistency>volatile</persistency>
    <readable/>
    <isVolatile/>
    <simpleType>
      <uint64_t/>
    </simpleType>
    <writeable/>
  </attribute>

  <enumerationType>
    <id>FUSED_CORE_MODE_WRITEABLE</id>
    <description>Summarizes the fused status of cores. This is same for all p10 chips
      in the system. If a core is in a fused state, attribute should read 1
      else zero. It needs to be populated during ipl but before istep 15.</description>
    <enumerator>
      <name>CORE_UNFUSED</name>
      <value>0x0</value>
    </enumerator>
    <enumerator>
      <name>CORE_FUSED</name>
      <value>0x1</value>
    </enumerator>
  </enumerationType>
  <attribute>
    <id>FUSED_CORE_MODE_WRITEABLE</id>
    <description>
      Plat fused core attribute to enable writeable property
    </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <writeable/>
    <simpleType>
      <uint8_t>
        <default>CORE_FUSED</default>
      </uint8_t>
    </simpleType>
    <hwpfToHbAttrMap>
      <id>ATTR_FUSED_CORE_MODE</id>
      <macro>DIRECT</macro>
    </hwpfToHbAttrMap>
  </attribute>

  <enumerationType>
    <id>BACKUP_SEEPROM_SELECT_WRITEABLE</id>
    <description>Select Primary or Backup Boot SEEPROM</description>
    <enumerator>
      <name>PRIMARY</name>
      <value>0x0</value>
    </enumerator>
    <enumerator>
      <name>SECONDARY</name>
      <value>0x1</value>
    </enumerator>
  </enumerationType>
  <attribute>
    <id>BACKUP_SEEPROM_SELECT_WRITEABLE</id>
    <description>
      Select Primary or Backup Boot SEEPROM Writeable property
    </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <writeable/>
    <simpleType>
      <uint8_t>
        <default>PRIMARY</default>
      </uint8_t>
    </simpleType>
    <hwpfToHbAttrMap>
      <id>ATTR_BACKUP_SEEPROM_SELECT</id>
      <macro>DIRECT</macro>
    </hwpfToHbAttrMap>
  </attribute>

  <enumerationType>
    <id>BACKUP_MEASUREMENT_SEEPROM_SELECT_WRITEABLE</id>
    <description>Select Primary or Backup Measurement SEEPROM</description>
    <enumerator>
      <name>PRIMARY</name>
      <value>0x0</value>
    </enumerator>
    <enumerator>
      <name>SECONDARY</name>
      <value>0x1</value>
    </enumerator>
  </enumerationType>
  <attribute>
    <id>BACKUP_MEASUREMENT_SEEPROM_SELECT_WRITEABLE</id>
    <description>
      Select Primary or Backup Boot SEEPROM Writeable property
    </description>
    <persistency>non-volatile</persistency>
    <readable/>
    <writeable/>
    <simpleType>
      <uint8_t>
        <default>PRIMARY</default>
      </uint8_t>
    </simpleType>
    <hwpfToHbAttrMap>
      <id>ATTR_BACKUP_MEASUREMENT_SEEPROM_SELECT</id>
      <macro>DIRECT</macro>
    </hwpfToHbAttrMap>
  </attribute>

</attributes>
